# 构建产物（可随时重新生成，不存档）
*.apk
*.aab
*.ap_
*.aar
# 例外：sherpa-onnx STT 原生库（端侧离线识别）随仓库分发，见 app/libs/README.md
!app/libs/*.aar
*.dex
*.class
bin/
gen/
out/
build/
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
captures/

# 机器相关 / IDE 本地配置（不该进版本库）
local.properties
.idea/
*.iml
*.log
.DS_Store

# 正式签名密钥与口令（绝不进版本库；keystore 实体在仓库外 ~/keystores/）
keystore.properties
*.jks
*.keystore

# Claude Code 本地状态（skills 是项目工作流的一部分，放行进版本库）
.claude/*
!.claude/skills/

# 兑换码序号计数器（tools，不进仓库）
tools/.last_serial
